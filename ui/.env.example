# Variaveis de ambiente da UI. Copie para .env.local (dev) ou configure no
# painel do provedor (producao). Nao versione o arquivo preenchido.

# ─────────────────────────────────────────────────────────────────
# OBRIGATORIA no modo nuvem
# ─────────────────────────────────────────────────────────────────
# Chave que assina os tokens de sessao emitidos pelas rotas /api/auth/*.
# Minimo de 32 caracteres. Sem ela a aplicacao recusa autenticar — de proposito:
# um valor padrao embutido tornaria todos os deploys forjaveis com a mesma chave.
#
# Gere um valor novo por ambiente com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# ─────────────────────────────────────────────────────────────────
# Modo de operacao
# ─────────────────────────────────────────────────────────────────
# true  = console local do appliance; o navegador fala direto com a API na
#         porta 8000 e AUTH_SECRET nao e usada.
# false = console de nuvem; exige AUTH_SECRET e o banco Postgres abaixo.
NEXT_PUBLIC_LOCAL_ONLY=false

# ─────────────────────────────────────────────────────────────────
# Banco de dados (somente modo nuvem)
# ─────────────────────────────────────────────────────────────────
POSTGRES_URL=
