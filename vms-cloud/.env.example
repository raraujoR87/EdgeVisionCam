# Banco. O papel da conexão precisa poder criar a role vms_app na migração.
DATABASE_URL=postgres://postgres:senha@localhost:5432/postgres

# Segredo de assinatura das sessões. Mínimo de 32 caracteres. Sem ele o servidor recusa autenticar.
AUTH_SECRET=

# Análise por IA. Sem a chave, os eventos são recebidos e marcados como FALHOU com motivo claro.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# URL pública, usada para montar o link de convite.
APP_URL=http://localhost:3000
