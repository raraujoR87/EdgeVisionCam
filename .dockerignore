# Ignore local Python virtual environments
venv/
.venv/
env/
ENV/

# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Ignore UI dependencies and builds (since ui has its own docker context)
ui/node_modules/
ui/.next/
ui/out/

# Ignore Git directory and settings
.git/
.gitignore
.dockerignore

# Ignore database data files (which should be mounted as volumes)
core/database/data/
*.db
*.db-journal
*.db-wal
edge/storage/
**/storage/

# Ignore logs
*.log
core_agent_e2e.log
test_run.log

# Pesos YOLO: quem os fornece e a etapa de download do Dockerfile, nao o
# contexto de build. Enviar copias locais so incharia a imagem — e poderia
# sobrescrever os pesos baixados por versoes desatualizadas da maquina de dev.
*.pt

# Testes nao vao para a imagem de producao
tests/
pytest.ini
